# --- EMAIL CONFIGURATION ---
# To send OTPs, you need to use a Gmail account with an App Password.
# 
# STEPS TO GENERATE A GMAIL APP PASSWORD:
# STEPS TO GET STARTED WITH RESEND:
# 1. Go to your Resend Account (https://resend.com)
# 2. Create an API Key in the API Keys section.
# 3. Use your verified domain email address as the sender.

# Brevo Email Configuration
BREVO_API_KEY="xkeysib-..."
SENDER_EMAIL="your_verified_gmail_address@gmail.com"

# --- SECURITY ---
JWT_SECRET=your_super_secret_key_at_least_32_characters_long

# --- DATABASE CONFIGURATION ---
DATABASE_URL=postgresql://user:password@host:port/dbname